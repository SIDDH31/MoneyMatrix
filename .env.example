# =============================================================================
# MoneyMatrix — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Database (MongoDB) -------------------------------------------------------
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/moneymatrix
# Or Local Docker: mongodb://localhost:27017/moneymatrix
MONGODB_URI=

# --- Authentication (Auth.js / NextAuth v5) -----------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# --- AI Financial Advisor ----------------------------------------------------
# Set ONE key. NVIDIA is used first if both are set (override with AI_PROVIDER).
# NVIDIA NIM (Llama 3.1 70B, free credits): https://build.nvidia.com -> "Get API Key"
NVIDIA_API_KEY=""
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: AI_PROVIDER=nvidia|gemini|custom, AI_MODEL=<model id>
# Custom OpenAI-compatible server: AI_PROVIDER=custom, AI_BASE_URL=..., AI_API_KEY=...

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MoneyMatrix"
